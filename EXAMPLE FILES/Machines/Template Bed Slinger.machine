# LARGER.slicer machine: template for a bed slinger (the bed moves in Y, the head in X and Z), no 3D model.
# Copy it into Documents/LARGER/Machines, rename it, change the values. Lines that begin with # are comments.
# Without a model Printer Simulation shows the bed as a plate and checks the head as a round body.
# Give it a model the same way as "Template Gantry.3dm": layers Frame, Bed, Z (the X beam), X (the head), TCP.
# The guide: docs/OWN_MACHINES.md

name = Template Bed Slinger
manufacturer = Me
kind = bedslinger
prefix = TBS
extension = .gcode
bed = 220 x 220 x 250

extrusion factor = 1
first layer factor = 1
filament diameter = 1.75
section = bead
travel speed = 9000

material = PLA
bed temperature = 60
nozzle temperature = 210
fan = 100
# where the bed is pushed to at the end, so you can take the part
set present y = 200

[start]
G21
G90
M140 S{bed}
M104 S{nozzle}
G28
M190 S{bed}
M109 S{nozzle}
G92 E0
M83

[after layer 1]
M106 S{fan} ; fan {fan %} %

[end]
G91
G1 F600 Z10
G90
G1 Y{present y} F3000 ; present the bed
M107
M104 S0
M140 S0
M84
